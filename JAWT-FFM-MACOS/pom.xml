<?xml version="1.0" encoding="UTF-8"?>
<project>
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.java.desktop</groupId>
    <artifactId>ffm-awt-macos</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <parent>
        <groupId>org.java.desktop</groupId>
        <artifactId>ffm-awt-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <dependencies>
        <dependency>
            <groupId>org.java.desktop</groupId>
            <artifactId>jawt-ffm-shared</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>native-maven-plugin</artifactId>
                <version>1.0.0</version>
                <extensions>true</extensions>
                <configuration>
                    <sources>
                        <source>
                            <directory>${project.basedir}/src/main/c</directory>
                            <includes>
                                <include>**/*.m</include>
                            </includes>
                        </source>
                    </sources>
                    <compilerStartOptions>
                        <compilerStartOption>-I${java.home}/include</compilerStartOption>
                        <compilerStartOption>-I${java.home}/include/darwin</compilerStartOption>
                        <compilerStartOption>-fPIC</compilerStartOption>
                    </compilerStartOptions>
                    <linkerStartOptions>
                        <linkerStartOption>-dynamiclib</linkerStartOption>
                        <linkerStartOption>-L${java.home}/lib</linkerStartOption>
                        <linkerStartOption>-ljawt</linkerStartOption>
                        <linkerStartOption>-framework</linkerStartOption>
                        <linkerStartOption>Cocoa</linkerStartOption>
                        <linkerStartOption>-framework</linkerStartOption>
                        <linkerStartOption>QuartzCore</linkerStartOption>
                    </linkerStartOptions>
                    <linkerOutputDirectory>${project.build.directory}/native</linkerOutputDirectory>
                    <linkerFinalName>libffmawtmacos</linkerFinalName>
                    <linkerFinalNameExt>dylib</linkerFinalNameExt>
                    <attach>false</attach>
                </configuration>
                <executions>
                    <execution>
                        <id>build-native-library</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>initialize</goal>
                            <goal>compile</goal>
                            <goal>link</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>